# Custom commands

c() {
    # When inside the Customerly folder, suggest running c-cly instead
    if [[ "$PWD" == /Users/giorgio/Documents/Customerly/* || "$PWD" == /Users/giorgio/Documents/Customerly ]]; then
        echo "You are inside the Customerly folder. Run 'c-cly' instead of 'c'."
        echo -n "Run 'c-cly' now instead? [Y/n] "
        read -r reply
        if [[ "$reply" == [nN] || "$reply" == [nN][oO] ]]; then
            claude --dangerously-skip-permissions "$@"
        else
            c-cly "$@"
        fi
        return
    fi
    # When inside the MangaTime folder, suggest running c-mt instead
    if [[ "$PWD" == /Users/giorgio/Documents/Personal/MangaTime/* || "$PWD" == /Users/giorgio/Documents/Personal/MangaTime ]]; then
        echo "You are inside the MangaTime folder. Run 'c-mt' instead of 'c'."
        echo -n "Run 'c-mt' now instead? [Y/n] "
        read -r reply
        if [[ "$reply" == [nN] || "$reply" == [nN][oO] ]]; then
            claude --dangerously-skip-permissions "$@"
        else
            c-mt "$@"
        fi
        return
    fi
    claude --dangerously-skip-permissions "$@"
}

